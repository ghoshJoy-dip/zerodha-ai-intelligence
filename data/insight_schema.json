{
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "enum": ["Risk Alert", "Diversification Review", "Watchlist Monitoring", "Summary Follow-up"]
    },
    "title": { "type": "string" },
    "explanation": { "type": "string" },
    "rationale": { "type": "string" },
    "supporting_metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "metric_name": { "type": "string" },
          "metric_value": { "type": "number" }
        },
        "required": ["metric_name", "metric_value"]
      }
    },
    "confidence": { "type": "number" },
    "freshness_timestamp": { "type": "string" },
    "disclaimer": { "type": "string" }
  },
  "required": ["category", "title", "explanation", "rationale", "supporting_metrics", "confidence", "freshness_timestamp", "disclaimer"]
}